/target
# `launcher-qt` is its own workspace (so the root build never needs Qt),
# so it has its own target directory that `/target` above doesn't cover.
/launcher-qt/target
# written by cxx-qt-build for the QML language server; holds this
# machine's absolute build path
/launcher-qt/.qmlls.ini
*.o
*.so
*.dylib
*.dll
/reference/**/*.bin
/reference/**/*.img
/reference/**/*.iso
/reference/**/*.cue
build/
/guest-tools/out/
/guest-tools/tools/
# DXVK writes <exe>_d3d9.log next to the cwd
*_d3d9.log
__pycache__/
*.pyc
