 #define WRAPPER_FLAG_MANAGED_TEXTURES       (0x8)
 
-FX_ENTRY void FX_CALL setConfig(FxU32 flags);
+/*
+ * 2ksbox: qemu-3dfx calls _setConfig@8 -- the flags plus a word it seeds
+ * with '$g2X' for the wrapper to sign -- and _setConfigRes@8 for the
+ * upscale width glidewnd.c computed. Both live in glidept/host/hostops.cpp
+ * (patches/openglide/03); bits 0x4 and 0x8 above are qemu-3dfx's MSAA
+ * count there, not these, and are ignored.
+ */
+#ifdef __cplusplus
+extern "C" {
+#endif
+FX_ENTRY void FX_CALL setConfig(FxU32 flags, void *magic);
+FX_ENTRY void FX_CALL setConfigRes(int res, void *swap12);
+#ifdef __cplusplus
+}
+#endif
 
 #endif /* WRAPPER_CONFIG_H */
