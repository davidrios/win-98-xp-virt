+static bool tcg_global_pin(TCGTemp *ts)
+{
+#ifdef TCG_TARGET_HAS_pinned_globals
+    TCGContext *s = tcg_ctx;
+
+    tcg_debug_assert(ts->kind == TEMP_GLOBAL);
+    tcg_debug_assert(!ts->indirect_reg && ts->base_type == ts->type);
+    tcg_debug_assert(ts->type == TCG_TYPE_I32 || ts->type == TCG_TYPE_I64);
+    tcg_debug_assert(!ts->pinned);
 
