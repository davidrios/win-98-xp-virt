+/*
+ * doc 18: "op T, ...; mov G, T" with G a pinned global and T a temp that
+ * dies in the mov becomes "op G, ..." — the i386 translator computes
+ * every result into a temp and moves it into the register global, which
+ * for a memory global is the store it needs anyway and for a pinned one
+ * a register move on top of the op. Valid when nothing between the two
+ * ops reads or writes G or reads T, and no op in between may fault or
+ * end the block (a fault there must see the old G). The op is renamed in
+ * place and the mov removed; the caller is walking backwards and has not
+ * processed the earlier ops yet.
+ */
+static bool la_coalesce_pinned_mov(TCGContext *s, TCGOp *op)
+{
+    TCGTemp *g = arg_temp(op->args[0]);
+    TCGTemp *t = arg_temp(op->args[1]);
+    TCGOp *p;
+    int i;
+
+    if (!g->pinned || t->state != TS_DEAD || g->type != t->type
+        || (t->kind != TEMP_EBB && t->kind != TEMP_TB)) {
+        return false;
+    }
+    for (p = QTAILQ_PREV(op, link); p != NULL; p = QTAILQ_PREV(p, link)) {
+        const TCGOpDef *def = &tcg_op_defs[p->opc];
+        int nb_oargs, nb_iargs;
+
+        switch (p->opc) {
+        case INDEX_op_insn_start:
+            continue;
+        case INDEX_op_call:
+            return false;
+        case INDEX_op_discard:
+            nb_oargs = 0;
+            nb_iargs = 1;
+            break;
+        default:
+            nb_oargs = def->nb_oargs;
+            nb_iargs = def->nb_iargs;
+            break;
         }
+        for (i = 0; i < nb_oargs; i++) {
+            if (arg_temp(p->args[i]) == t) {
+                /* The definition: its output is written after any fault. */
+                if ((p->opc == INDEX_op_mov_i32 || p->opc == INDEX_op_mov_i64)
+                    && arg_temp(p->args[1]) == g) {
+                    return false;
+                }
+                p->args[i] = temp_arg(g);
+                tcg_op_remove(s, op);
+                return true;
+            }
+        }
+        if (def->flags & (TCG_OPF_BB_END | TCG_OPF_COND_BRANCH
+                          | TCG_OPF_SIDE_EFFECTS)) {
+            return false;
+        }
+        for (i = 0; i < nb_oargs + nb_iargs; i++) {
+            TCGTemp *a = arg_temp(p->args[i]);
+            if (a == g || a == t) {
+                return false;
+            }
+        }
     }
+    return false;
 }
 
