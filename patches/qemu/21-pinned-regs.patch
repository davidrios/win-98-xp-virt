+        return false;
+    }
+    /* QEMU_TCG_PIN_MAX=n: the pin budget (experiments: what to leave the temps) */
+    {
+        const char *e = getenv("QEMU_TCG_PIN_MAX");
+        if (e && ctpop64(s->pinned_regs) >= atoi(e)) {
+            return false;
+        }
+    }
+    for (int i = 0; i < ARRAY_SIZE(tcg_target_pinned_regs); i++) {
+        TCGReg reg = tcg_target_pinned_regs[i];
+
+        if (tcg_regset_test_reg(s->reserved_regs, reg)) {
+            continue;
+        }
+        tcg_debug_assert(!tcg_regset_test_reg(tcg_target_call_clobber_regs, reg));
+        ts->pinned = 1;
+        ts->reg = reg;
+        tcg_regset_set_reg(s->reserved_regs, reg);
+        tcg_regset_set_reg(s->pinned_regs, reg);
