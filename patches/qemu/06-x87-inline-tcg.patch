+/*
+ * x87 inline fast path: the 53-bit-precision common case as TCG ops.
+ *
+ * Mirrors the helper fast path (x87-fast.h) instruction by instruction,
+ * generating host-FPU binary64 ops (add/sub/mul/div/fmsub_f64) inline
+ * instead of calling helpers. Every check that x87f_binop() makes is
+ * made here before any architectural state is touched; whenever it would
+ * return false we branch to the unmodified helper sequence, so the
+ * observable result (value, tags, status word) is identical to the
+ * helper path, which is identical to softfloat.
+ *
+ * Only PC=53 / RC=nearest / PE masked (env->x87_fast_mode == 1) is
+ * inlined; other control words take the helper path.
+ *
+ * Code-generation notes: each instruction is one extended basic block
+ * with exits to `slow` and a single join at `done`. The checks are
+ * branchless (setcond/movcond) so the fast path contains no labels:
+ * every value is an EBB temp that never has to be synced to its stack
+ * slot at a conditional branch. Only the memory operand (needed by the
+ * helper on the slow path) is a TB temp.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "tcg/tcg-temp-internal.h"
+
+#define X87I_BIAS_X80   16383
+#define X87I_BIAS_F64   1023
+#define X87I_WIN        900     /* X87F_WIN_D: 2^-900 .. 2^900 */
+
+QEMU_BUILD_BUG_ON(sizeof(FPReg) != 16);
+
+static bool x87i_available(void)
+{
+    return tcg_f64_supported();
+}
+
+/* branch unless env->x87_fast_mode == 1 */
+static void x87i_check_mode(TCGLabel *slow)
+{
+    TCGv_i32 m = tcg_temp_ebb_new_i32();
+
+    tcg_gen_ld8u_i32(m, tcg_env, offsetof(CPUX86State, x87_fast_mode));
+    tcg_gen_brcondi_i32(TCG_COND_NE, m, 1, slow);
+}
+
+/* (fpstt + i) & 7 */
+static TCGv_i32 x87i_st_index(int i)
+{
+    TCGv_i32 idx = tcg_temp_ebb_new_i32();
+
+    tcg_gen_ld_i32(idx, tcg_env, offsetof(CPUX86State, fpstt));
+    if (i) {
+        tcg_gen_addi_i32(idx, idx, i);
+        tcg_gen_andi_i32(idx, idx, 7);
+    }
+    return idx;
+}
+
+/* &env->fpregs[idx] */
+static TCGv_ptr x87i_st_ptr(TCGv_i32 idx)
+{
+    TCGv_i32 t = tcg_temp_ebb_new_i32();
+    TCGv_ptr p = tcg_temp_ebb_new_ptr();
+
+    tcg_gen_shli_i32(t, idx, 4);
+    tcg_gen_ext_i32_ptr(p, t);
+    tcg_gen_add_ptr(p, p, tcg_env);
+    tcg_gen_addi_ptr(p, p, offsetof(CPUX86State, fpregs));
+    return p;
+}
+
+static void x87i_ld_x80(TCGv_i64 low, TCGv_i32 high, TCGv_ptr p)
+{
+    tcg_gen_ld_i64(low, p, offsetof(FPReg, d.low));
+    tcg_gen_ld16u_i32(high, p, offsetof(FPReg, d.high));
+}
+
+static void x87i_st_x80(TCGv_ptr p, TCGv_i64 low, TCGv_i32 high)
+{
+    tcg_gen_st_i64(low, p, offsetof(FPReg, d.low));
+    tcg_gen_st16_i32(high, p, offsetof(FPReg, d.high));
+}
+
+static void x87i_set_tag(TCGv_i32 idx, int tag)
+{
+    TCGv_ptr p = tcg_temp_ebb_new_ptr();
+
+    tcg_gen_ext_i32_ptr(p, idx);
+    tcg_gen_add_ptr(p, p, tcg_env);
+    tcg_gen_st8_i32(tcg_constant_i32(tag), p, offsetof(CPUX86State, fptags));
+}
+
+static void x87i_set_top(TCGv_i32 idx)
+{
+    tcg_gen_st_i32(idx, tcg_env, offsetof(CPUX86State, fpstt));
+}
+
+/* fpush(): fpstt = (fpstt - 1) & 7; fptags[fpstt] = 0. Returns new top. */
+static TCGv_i32 x87i_push(void)
+{
+    TCGv_i32 idx = x87i_st_index(7);
+
+    x87i_set_tag(idx, 0);
+    x87i_set_top(idx);
+    return idx;
+}
+
+/* fpop(): fptags[fpstt] = 1; fpstt = (fpstt + 1) & 7 */
+static void x87i_pop(void)
+{
+    TCGv_i32 idx = x87i_st_index(0);
+
+    x87i_set_tag(idx, 1);
+    tcg_gen_addi_i32(idx, idx, 1);
+    tcg_gen_andi_i32(idx, idx, 7);
+    x87i_set_top(idx);
+}
+
+/*
+ * x80 (low, high) -> binary64 bit pattern, exact. Branches to slow unless
+ * the value is zero or a normal with a 53-bit mantissa whose exponent is
+ * within [-win, win] (x87f_x80_to_d). Branchless apart from the exit.
+ */
+static void x87i_x80_to_f64(TCGv_i64 out, TCGv_i64 low, TCGv_i32 high,
+                            int win, TCGLabel *slow)
+{
+    TCGv_i64 zero = tcg_constant_i64(0);
+    TCGv_i64 e = tcg_temp_ebb_new_i64();
+    TCGv_i64 t = tcg_temp_ebb_new_i64();
+    TCGv_i64 bad = tcg_temp_ebb_new_i64();
+    TCGv_i64 iszero = tcg_temp_ebb_new_i64();
+    TCGv_i64 sign = tcg_temp_ebb_new_i64();
+
+    tcg_gen_extu_i32_i64(e, high);
+    tcg_gen_andi_i64(sign, e, 0x8000);
+    tcg_gen_shli_i64(sign, sign, 48);
+    tcg_gen_andi_i64(e, e, 0x7fff);
+
+    /* zero: e == 0 && low == 0 */
+    tcg_gen_or_i64(t, e, low);
+    tcg_gen_setcondi_i64(TCG_COND_EQ, iszero, t, 0);
+
+    /* exponent window */
+    tcg_gen_subi_i64(e, e, X87I_BIAS_X80 - win);
+    tcg_gen_setcondi_i64(TCG_COND_GTU, bad, e, 2 * win);
+    /* explicit integer bit set, low 11 mantissa bits clear */
+    tcg_gen_andi_i64(t, low, 0x7ff);
+    tcg_gen_setcondi_i64(TCG_COND_NE, t, t, 0);
+    tcg_gen_or_i64(bad, bad, t);
+    tcg_gen_setcondi_i64(TCG_COND_GE, t, low, 0);
+    tcg_gen_or_i64(bad, bad, t);
+    /* bad && !zero -> slow */
+    tcg_gen_andc_i64(bad, bad, iszero);
+    tcg_gen_brcondi_i64(TCG_COND_NE, bad, 0, slow);
+
+    tcg_gen_addi_i64(e, e, X87I_BIAS_F64 - win);
+    tcg_gen_shli_i64(e, e, 52);
+    tcg_gen_shli_i64(t, low, 1);
+    tcg_gen_shri_i64(t, t, 12);
+    tcg_gen_or_i64(t, t, e);
+    tcg_gen_or_i64(t, t, sign);
+    tcg_gen_movcond_i64(TCG_COND_NE, out, iszero, zero, sign, t);
+}
+
+/* binary64 (zero or normal) -> x80, exact (x87f_d_to_x80). */
+static void x87i_f64_to_x80(TCGv_i64 low, TCGv_i32 high, TCGv_i64 d)
+{
+    TCGv_i64 zero = tcg_constant_i64(0);
+    TCGv_i64 e = tcg_temp_ebb_new_i64();
+    TCGv_i64 t = tcg_temp_ebb_new_i64();
+    TCGv_i64 h = tcg_temp_ebb_new_i64();
+
+    tcg_gen_shri_i64(e, d, 52);
+    tcg_gen_andi_i64(e, e, 0x7ff);
+
+    tcg_gen_shli_i64(t, d, 11);
+    tcg_gen_ori_i64(t, t, 1ULL << 63);
+    tcg_gen_movcond_i64(TCG_COND_NE, low, e, zero, t, zero);
+
+    tcg_gen_addi_i64(t, e, X87I_BIAS_X80 - X87I_BIAS_F64);
+    tcg_gen_movcond_i64(TCG_COND_NE, t, e, zero, t, zero);
+    tcg_gen_shri_i64(h, d, 48);
+    tcg_gen_andi_i64(h, h, 0x8000);
+    tcg_gen_or_i64(h, h, t);
+    tcg_gen_extrl_i64_i32(high, h);
+}
+
+/*
+ * Branch to slow unless d is zero or a normal whose biased exponent is
+ * in [lo, lo + range]. Operand window and result acceptance (x87f_d_ok)
+ * use lo = 1023 - 900, range = 1800; fld m64 accepts every normal:
+ * lo = 1, range = 0x7fd.
+ */
+static void x87i_f64_check(TCGv_i64 d, int lo, int range, TCGLabel *slow)
+{
+    TCGv_i64 t = tcg_temp_ebb_new_i64();
+    TCGv_i64 bad = tcg_temp_ebb_new_i64();
+    TCGv_i64 iszero = tcg_temp_ebb_new_i64();
+
+    tcg_gen_shli_i64(t, d, 1);
+    tcg_gen_setcondi_i64(TCG_COND_EQ, iszero, t, 0);
+    tcg_gen_shri_i64(t, t, 53);
+    tcg_gen_subi_i64(t, t, lo);
+    tcg_gen_setcondi_i64(TCG_COND_GTU, bad, t, range);
+    tcg_gen_andc_i64(bad, bad, iszero);
+    tcg_gen_brcondi_i64(TCG_COND_NE, bad, 0, slow);
+}
+
+static void x87i_f64_check_win(TCGv_i64 d, TCGLabel *slow)
+{
+    x87i_f64_check(d, X87I_BIAS_F64 - X87I_WIN, 2 * X87I_WIN, slow);
+}
+
+/* t = (d == +-0) */
+static void x87i_iszero(TCGv_i64 t, TCGv_i64 d)
+{
+    tcg_gen_shli_i64(t, d, 1);
+    tcg_gen_setcondi_i64(TCG_COND_EQ, t, t, 0);
+}
+
+/* fpus |= PE if the residual err is nonzero */
+static void x87i_set_pe(TCGv_i64 err)
+{
+    TCGv_i64 t = tcg_temp_ebb_new_i64();
+    TCGv_i32 pe = tcg_temp_ebb_new_i32();
+    TCGv_i32 fpus = tcg_temp_ebb_new_i32();
+
+    tcg_gen_shli_i64(t, err, 1);
+    tcg_gen_setcondi_i64(TCG_COND_NE, t, t, 0);
+    tcg_gen_extrl_i64_i32(pe, t);
+    tcg_gen_shli_i32(pe, pe, 5);            /* FPUS_PE */
+    tcg_gen_ld16u_i32(fpus, tcg_env, offsetof(CPUX86State, fpus));
+    tcg_gen_or_i32(fpus, fpus, pe);
+    tcg_gen_st16_i32(fpus, tcg_env, offsetof(CPUX86State, fpus));
+}
+
+/*
+ * r = a OP b on binary64 patterns a, b (each zero or normal inside the
+ * window), with the inexact flag recovered from the residual
+ * (x87f_binop_d). op: 0 add, 1 mul, 4 sub (a - b), 5 subr (b - a),
+ * 6 div (a / b), 7 divr (b / a). Branches to slow when x87f_binop_d
+ * would return false.
+ */
+static void x87i_binop(TCGv_i64 r, int op, TCGv_i64 a, TCGv_i64 b,
+                       TCGLabel *slow)
+{
+    TCGv_i64 err = tcg_temp_ebb_new_i64();
+    TCGv_i64 t1 = tcg_temp_ebb_new_i64();
+    TCGv_i64 t2 = tcg_temp_ebb_new_i64();
+    TCGv_i64 t3 = tcg_temp_ebb_new_i64();
+
+    if (op == 5 || op == 7) {
+        TCGv_i64 x = a;
+        a = b;
+        b = x;
+        op--;
+    }
+
+    switch (op) {
+    case 0:
+    case 4:
+        if (op == 4) {
+            TCGv_i64 nb = tcg_temp_ebb_new_i64();
+            tcg_gen_xori_i64(nb, b, 1ULL << 63);
+            b = nb;
+        }
+        tcg_gen_add_f64(r, a, b);
+        x87i_f64_check_win(r, slow);
+        /* TwoSum: bb = r - a; err = (a - (r - bb)) + (b - bb) */
+        tcg_gen_sub_f64(t1, r, a);
+        tcg_gen_sub_f64(t2, r, t1);
+        tcg_gen_sub_f64(t2, a, t2);
+        tcg_gen_sub_f64(t1, b, t1);
+        tcg_gen_add_f64(err, t2, t1);
+        break;
+    case 1:
+        tcg_gen_mul_f64(r, a, b);
+        x87i_f64_check_win(r, slow);
+        /* r == 0 with nonzero operands: underflow */
+        x87i_iszero(t1, r);
+        x87i_iszero(t2, a);
+        x87i_iszero(t3, b);
+        tcg_gen_or_i64(t2, t2, t3);
+        tcg_gen_andc_i64(t1, t1, t2);
+        tcg_gen_brcondi_i64(TCG_COND_NE, t1, 0, slow);
+        tcg_gen_fmsub_f64(err, a, b, r);
+        break;
+    case 6:
+        x87i_iszero(t1, b);                       /* ZE / IE */
+        tcg_gen_brcondi_i64(TCG_COND_NE, t1, 0, slow);
+        tcg_gen_div_f64(r, a, b);
+        x87i_f64_check_win(r, slow);
+        /* r == 0 with a != 0: underflow */
+        x87i_iszero(t1, r);
+        x87i_iszero(t2, a);
+        tcg_gen_andc_i64(t1, t1, t2);
+        tcg_gen_brcondi_i64(TCG_COND_NE, t1, 0, slow);
+        tcg_gen_fmsub_f64(err, r, b, a);
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    x87i_set_pe(err);
+}
+
+/* fadd/fmul/fsub/fsubr/fdiv/fdivr ST0, m64; the operand is in m64. */
+static void gen_x87i_arith_m64(DisasContext *s, int op1, TCGv_i64 m64)
+{
+    TCGLabel *slow = gen_new_label();
+    TCGLabel *done = gen_new_label();
+    TCGv_i64 m = tcg_temp_new_i64();            /* live on the slow path */
+    TCGv_i64 a = tcg_temp_ebb_new_i64();
+    TCGv_i64 r = tcg_temp_ebb_new_i64();
+    TCGv_i64 low = tcg_temp_ebb_new_i64();
+    TCGv_i32 high = tcg_temp_ebb_new_i32();
+    TCGv_i32 idx;
+    TCGv_ptr p;
+
+    tcg_gen_mov_i64(m, m64);
+    x87i_check_mode(slow);
+    x87i_f64_check_win(m, slow);
+    idx = x87i_st_index(0);
+    p = x87i_st_ptr(idx);
+    x87i_ld_x80(low, high, p);
+    x87i_x80_to_f64(a, low, high, X87I_WIN, slow);
+    x87i_binop(r, op1, a, m, slow);
+    x87i_f64_to_x80(low, high, r);
+    x87i_st_x80(p, low, high);
+    tcg_gen_br(done);
+
+    gen_set_label(slow);
+    gen_helper_fldl_FT0(tcg_env, m);
+    gen_helper_fp_arith_ST0_FT0(op1);
+    gen_set_label(done);
+}
+
+/*
+ * Register forms. stn_form = false: ST0 = ST0 op ST(i) (FT0 = ST(i));
+ * stn_form = true: ST(i) = ST(i) op ST0 with the reversed-r encoding of
+ * gen_helper_fp_arith_STN_ST0 (op1 4..7 swap direction). pop: fpop after.
+ */
+static void gen_x87i_arith_st(DisasContext *s, int op1, int opreg,
+                              bool stn_form, bool pop)
+{
+    TCGLabel *slow = gen_new_label();
+    TCGLabel *done = gen_new_label();
+    TCGv_i64 a = tcg_temp_ebb_new_i64();
+    TCGv_i64 b = tcg_temp_ebb_new_i64();
+    TCGv_i64 r = tcg_temp_ebb_new_i64();
+    TCGv_i64 low = tcg_temp_ebb_new_i64();
+    TCGv_i32 high = tcg_temp_ebb_new_i32();
+    TCGv_i32 idx0, idxn;
+    TCGv_ptr p0, pn, pdst;
+    int op = op1;
+
+    x87i_check_mode(slow);
+    idx0 = x87i_st_index(0);
+    idxn = x87i_st_index(opreg);
+    p0 = x87i_st_ptr(idx0);
+    pn = x87i_st_ptr(idxn);
+    if (stn_form) {
+        /* a = ST(i), b = ST0; helper op1 4..7 means b-a, a-b, b/a, a/b */
+        x87i_ld_x80(low, high, pn);
+        x87i_x80_to_f64(a, low, high, X87I_WIN, slow);
+        x87i_ld_x80(low, high, p0);
+        x87i_x80_to_f64(b, low, high, X87I_WIN, slow);
+        if (op >= 4) {
+            op ^= 1;
+        }
+        pdst = pn;
+    } else {
+        x87i_ld_x80(low, high, p0);
+        x87i_x80_to_f64(a, low, high, X87I_WIN, slow);
+        x87i_ld_x80(low, high, pn);
+        x87i_x80_to_f64(b, low, high, X87I_WIN, slow);
+        pdst = p0;
+    }
+    x87i_binop(r, op, a, b, slow);
+    x87i_f64_to_x80(low, high, r);
+    x87i_st_x80(pdst, low, high);
+    tcg_gen_br(done);
+
+    gen_set_label(slow);
+    if (stn_form) {
+        gen_helper_fp_arith_STN_ST0(op1, opreg);
+    } else {
+        gen_helper_fmov_FT0_STN(tcg_env, tcg_constant_i32(opreg));
+        gen_helper_fp_arith_ST0_FT0(op1);
+    }
+    gen_set_label(done);
+    if (pop) {
+        x87i_pop();
+    }
+}
+
+/* fld m64 */
+static void gen_x87i_fld_m64(DisasContext *s, TCGv_i64 m64)
+{
+    TCGLabel *slow = gen_new_label();
+    TCGLabel *done = gen_new_label();
+    TCGv_i64 m = tcg_temp_new_i64();
+    TCGv_i64 low = tcg_temp_ebb_new_i64();
+    TCGv_i32 high = tcg_temp_ebb_new_i32();
+    TCGv_i32 idx;
+
+    tcg_gen_mov_i64(m, m64);
+    x87i_check_mode(slow);
+    x87i_f64_check(m, 1, 0x7fd, slow);        /* normal or zero */
+    x87i_f64_to_x80(low, high, m);
+    idx = x87i_push();
+    x87i_st_x80(x87i_st_ptr(idx), low, high);
+    tcg_gen_br(done);
+
+    gen_set_label(slow);
+    gen_helper_fldl_ST0(tcg_env, m);
+    gen_set_label(done);
+}
+
+/* fst/fstp m64: the binary64 value is left in out; caller stores + pops */
+static void gen_x87i_fst_m64(DisasContext *s, TCGv_i64 out)
+{
+    TCGLabel *slow = gen_new_label();
+    TCGLabel *done = gen_new_label();
+    TCGv_i64 d = tcg_temp_ebb_new_i64();
+    TCGv_i64 low = tcg_temp_ebb_new_i64();
+    TCGv_i32 high = tcg_temp_ebb_new_i32();
+    TCGv_i32 idx;
+
+    x87i_check_mode(slow);
+    idx = x87i_st_index(0);
+    x87i_ld_x80(low, high, x87i_st_ptr(idx));
+    /* exact in the full double range: x87f_to_f64 */
+    x87i_x80_to_f64(d, low, high, 1022, slow);
+    tcg_gen_mov_i64(out, d);
+    tcg_gen_br(done);
+
+    gen_set_label(slow);
+    gen_helper_fstl_ST0(out, tcg_env);
+    gen_set_label(done);
+}
+
+/* fld st(i): push, then ST0 = old ST(i) (now ST(i+1)) */
+static void gen_x87i_fld_st(DisasContext *s, int opreg)
+{
+    TCGv_i64 low = tcg_temp_ebb_new_i64();
+    TCGv_i32 high = tcg_temp_ebb_new_i32();
+    TCGv_i32 idx;
+
+    x87i_ld_x80(low, high, x87i_st_ptr(x87i_st_index(opreg)));
+    idx = x87i_push();
+    x87i_st_x80(x87i_st_ptr(idx), low, high);
+}
+
+/* fxch st(i) */
+static void gen_x87i_fxch(DisasContext *s, int opreg)
+{
+    TCGv_i64 low0 = tcg_temp_ebb_new_i64();
+    TCGv_i32 high0 = tcg_temp_ebb_new_i32();
+    TCGv_i64 lown = tcg_temp_ebb_new_i64();
+    TCGv_i32 highn = tcg_temp_ebb_new_i32();
+    TCGv_ptr p0 = x87i_st_ptr(x87i_st_index(0));
+    TCGv_ptr pn = x87i_st_ptr(x87i_st_index(opreg));
+
+    x87i_ld_x80(low0, high0, p0);
+    x87i_ld_x80(lown, highn, pn);
+    x87i_st_x80(p0, lown, highn);
+    x87i_st_x80(pn, low0, high0);
+}
+
+/* fst/fstp st(i): ST(i) = ST0 */
+static void gen_x87i_fst_st(DisasContext *s, int opreg, bool pop)
+{
+    TCGv_i64 low = tcg_temp_ebb_new_i64();
+    TCGv_i32 high = tcg_temp_ebb_new_i32();
+
+    x87i_ld_x80(low, high, x87i_st_ptr(x87i_st_index(0)));
+    x87i_st_x80(x87i_st_ptr(x87i_st_index(opreg)), low, high);
+    if (pop) {
+        x87i_pop();
+    }
+}
