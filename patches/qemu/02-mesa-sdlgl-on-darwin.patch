Use qemu-3dfx's SDL GL context backend (mglcntx_sdlgl.c, native
OpenGL.framework) instead of the GLX/XQuartz one on macOS.

On macOS the SDL window is Cocoa, so the patched ui/sdl2.c hands the Mesa
backend an NSWindow* (wmi.info.cocoa.window); the GLX backend
(mglcntx_linux.c) treats it as an X11 window id and XQuartz answers
"X Error of failed request: BadDrawable (Apple-DRI)". Upstream's macOS path
therefore needs an X11-capable SDL2 running on XQuartz, which Homebrew's
SDL2 is not (and XQuartz GLX is broken on Tahoe anyway, XQuartz #446).
Upstream ships mglcntx_sdlgl.c with a CONFIG_DARWIN path but does not build
it; both backends export the identical symbol set. Linux keeps GLX.

Also define GL_TEXTURE_RECTANGLE_NV/GL_TEXTURE_BINDING_RECTANGLE_NV when the
GL headers reached via SDL_opengl.h + GL_GLEXT_LEGACY (macOS) lack them.

--- a/hw/mesa/mglcntx_sdlgl.c
+++ b/hw/mesa/mglcntx_sdlgl.c
@@ -290,6 +290,11 @@
 #define WGL_TEXTURE_TARGET_ARB                  0x2073
 #define WGL_TEXTURE_2D_ARB                      0x207A
 #define WGL_TEXTURE_RECTANGLE_NV                0x20A2
+/* SDL_opengl.h with GL_GLEXT_LEGACY (macOS) lacks the glext enums */
+#ifndef GL_TEXTURE_RECTANGLE_NV
+#define GL_TEXTURE_RECTANGLE_NV                 0x84F5
+#define GL_TEXTURE_BINDING_RECTANGLE_NV         0x84F6
+#endif
 #define WGL_MIPMAP_LEVEL_ARB                    0x207B
 
 typedef struct tagFakePBuffer {
--- a/hw/mesa/meson.build
+++ b/hw/mesa/meson.build
@@ -1,9 +1,10 @@
+mesa_ctx = host_os == 'darwin' ? 'mglcntx_sdlgl.c' : 'mglcntx_linux.c'
 i386_system_ss.add(files(
   'extensions_table.c',
   'mesagl_blit.c',
   'mesagl_impl.c',
   'mesapt_mm.c',
-  'mglcntx_linux.c',
+  mesa_ctx,
   'mglcntx_mingw.c',
   'mglmapbo.c',
   'mglvarry.c',
