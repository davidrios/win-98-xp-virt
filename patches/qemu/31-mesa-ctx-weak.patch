+/*
+ * 2ksbox: this file holds two things — the WGL backend (down to
+ * "#endif //CONFIG_WIN32") and the platform-independent helpers every
+ * backend needs (from there to the end of the file). They have to be
+ * compiled separately on Windows, because the emulator and
+ * libqemu-embed share every object in one static library and the embed
+ * library brings its *own* backend (embed/mglcntx_embed.c, window-less):
+ * two strong definitions of MGLCreateContext do not link, and a weak one
+ * leaves qemu-system with nothing to call (COFF weak externals are not
+ * ELF's). So the archive's copy is the helpers, and meson.build compiles
+ * this file once more with MESAGL_WGL_BACKEND for the emulators alone.
+ */
+#if defined(CONFIG_WIN32) && defined(MESAGL_WGL_BACKEND)
 #include <GL/wgl.h>
 #include "system/whpx.h"
 
