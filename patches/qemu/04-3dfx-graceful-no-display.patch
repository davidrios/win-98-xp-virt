Do not kill the VM when a guest activates GL pass-through without an SDL
display (the player runs -display none): sdl_display_valid() reports instead
of exit(1), mesa_prepare_window() hands the backend a NULL window, and the
Mesa backends refuse context creation so the guest's wglCreateContext fails
cleanly. Glide pass-through still exits (its window path is not NULL-safe);
both get a real window-less context provider in M3.

--- a/hw/mesa/mglcntx_linux.c	2026-09-02 17:07:11.346825984 -0300
+++ b/hw/mesa/mglcntx_linux.c	2026-09-02 17:07:11.362491177 -0300
@@ -416,6 +416,10 @@
 int MGLCreateContext(uint32_t gDC)
 {
     int i, ret;
+    if (!win) {
+        DPRINTF("no window: GL context refused");
+        return 1;
+    }
     i = gDC & (MAX_PBUFFER - 1);
     if (gDC == ((MESAGL_HPBDC & 0xFFFFFFF0U) | i)) {
         ret = 0;
@@ -437,6 +441,8 @@
 
 int MGLMakeCurrent(uint32_t cntxRC, int level)
 {
+    if (!win)
+        return 0;
     int n = (level)? ((level % MAX_LVLCNTX)? (level % MAX_LVLCNTX):1):level;
     uint32_t i = cntxRC & (MAX_PBUFFER - 1);
     if (cntxRC == (MESAGL_MAGIC - n)) {
