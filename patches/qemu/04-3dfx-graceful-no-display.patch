--- a/ui/sdl2.c	2026-09-02 17:07:11.339428257 -0300
+++ b/ui/sdl2.c	2026-09-02 17:07:11.362148411 -0300
@@ -816,16 +816,21 @@
     SDL_QuitSubSystem(SDL_INIT_VIDEO);
 }
 
-static void sdl_display_valid(const char *feat)
+/* win98-xp-virt: report instead of exit(1) — under an embedding frontend
+ * (-display none) a guest launching a 3D title must not kill the VM. Callers
+ * hand the backend a NULL window so context creation fails cleanly. */
+static bool sdl_display_valid(const char *feat)
 {
     if (!sdl2_console) {
-        error_report("%s: invalid sdl display. Use '-display sdl'", feat);
-        exit(1);
+        error_report("%s: no SDL display (3D pass-through needs '-display sdl'); "
+                     "refusing GL context", feat);
+        return false;
     }
     if (sdl2_console[0].opengl) {
         error_report("%s: qemu-3dfx activation conflicts with display 'sdl,gl=on'", feat);
         exit(1);
     }
+    return true;
 }
